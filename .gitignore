# ============================================================
# ROOT .gitignore — Melly Salon Project
# ============================================================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor & IDE directories
.vscode/
.idea/
.nova/
.zed/
.cursor/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files — NEVER commit these!
.env
.env.local
.env.*.local
.env.backup
.env.production
.env.staging

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Backend (Laravel)
# ============================================================
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/pail/
backend/storage/logs/*.log
backend/.phpunit.result.cache
backend/.phpunit.cache/
backend/auth.json
backend/_ide_helper.php
backend/Homestead.json
backend/Homestead.yaml

# ============================================================
# Frontend (React + Vite)
# ============================================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
